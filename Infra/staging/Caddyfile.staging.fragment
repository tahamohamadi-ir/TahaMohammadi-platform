staging.tahamohamadi.ir {
  header X-Robots-Tag "noindex, nofollow, noarchive"
  redir /admin /admin/ 308
  handle /admin/* {
    reverse_proxy taha-cms-stage-admin-1:8080
  }
  handle /health/* {
    reverse_proxy taha-cms-stage-cms-1:8000
  }
  handle /static/* {
    reverse_proxy taha-cms-stage-cms-1:8000
  }
  handle /api/* {
    reverse_proxy taha-cms-stage-cms-1:8000
  }
  handle /media/* {
    reverse_proxy taha-cms-stage-cms-1:8000
  }
  handle /preview/* {
    reverse_proxy taha-cms-stage-cms-1:8000
  }
  handle /staff/* {
    reverse_proxy taha-cms-stage-cms-1:8000
  }
  reverse_proxy taha-cms-stage-web-1:8080
}
